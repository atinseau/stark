# ──────────────────────────────────────────────────────────────────────────────
# Stark — Environment Variables
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Seq ingestion API URL (used by pino-seq transport & import script)
SEQ_URL=http://localhost:5341

# Seq admin password (used on first run to create the admin account)
SEQ_ADMIN_PASSWORD=stark

# Seq port configuration (used by docker-compose)
SEQ_INGEST_PORT=5341
SEQ_UI_PORT=8082

# Seq Web UI URL (for reference only — open this in your browser)
SEQ_UI_URL=http://localhost:8082
